# ─── Frontend env (Vite) ──────────────────────────────────────────────────────
# Copy to .env and adjust.

# Leave UNSET for local dev — the Vite dev server proxies /api to the
# Express backend on http://localhost:8000 (same-origin cookies).

# For the deployed site (Vercel), point this at your hosted backend:
# VITE_API_URL=https://your-backend.onrender.com/api/v1
#
# Render migration (Sep 2026): backend now runs on Render.
#   VITE_API_URL=https://<your-service>.onrender.com/api/v1
#
# ─── Razorpay ─────────────────────────────────────────────────────────────────
# Only the PUBLIC key id is ever exposed to the browser (checkout.js).
# It is optional: the backend already returns the key id from
# POST /orders/checkout and POST /payments/razorpay/order. Set it here only as
# a fallback for the Razorpay modal.
# NEVER put RAZORPAY_KEY_SECRET in a VITE_* variable — anything VITE_-prefixed
# is bundled into the client.
# VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
