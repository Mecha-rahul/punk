# ─── Frontend env (Vite) ──────────────────────────────────────────────────────
# Copy to .env and adjust.

# Leave UNSET for local dev — the Vite dev server proxies /api to the
# Express backend on http://localhost:8000 (same-origin cookies).

# For the deployed site (Vercel), point this at your hosted backend:
# VITE_API_URL=https://your-backend.onrender.com/api/v1
